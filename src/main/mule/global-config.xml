		<os:connection >
			<reconnection >
				<reconnect />
			</reconnection>
		</os:connection>
	</os:config>
	<os:object-store name="Object_store" doc:name="Object store" doc:id="e580f52b-2401-408b-ade4-30b9896aa622" maxEntries="10" entryTtl="30" expirationInterval="10" expirationIntervalUnit="DAYS" config-ref="ObjectStore_Config" entryTtlUnit="DAYS"/>
	<os:object-store name="Object_store_salesforce_oauth" doc:name="Object store" doc:id="e3285748-ccea-41ea-b00f-69b91ec27f78" entryTtl="30" entryTtlUnit="MINUTES" expirationInterval="10" />
	<os:object-store name="Outlook_Object_store" doc:name="Object store" doc:id="4ba4005f-994a-421b-b50c-e507fb1c98a4" maxEntries="2" entryTtl="7" entryTtlUnit="DAYS" expirationInterval="6" expirationIntervalUnit="DAYS" />
