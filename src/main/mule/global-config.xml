http://www.mulesoft.org/schema/mule/snowflake http://www.mulesoft.org/schema/mule/snowflake/current/mule-snowflake.xsd
http://www.mulesoft.org/schema/mule/outlook365 http://www.mulesoft.org/schema/mule/outlook365/current/mule-outlook365.xsd">
	<global-property doc:name="Global Property" doc:id="5f18e815-4e99-4345-81af-77bb8ee2c889" name="mule.encryptionKey" value="SQA@Plative12345" />
	<global-property doc:name="Global Property" doc:id="85409904-e275-4c27-ad53-4c0d7b42f53d" name="mule.env" value="sandbox" />
	<salesforce:sfdc-config name="Salesforce_Config" doc:name="Salesforce Config" doc:id="bda07559-cfd9-46a0-9c1c-569b18365599" >
		<salesforce:oauth-client-credentials-connection >
			<reconnection >
				<reconnect />
			</reconnection>
			<salesforce:oauth-client-credentials clientId="${secure::salesforce.clientId}" clientSecret="${secure::salesforce.clientSecret}" tokenUrl='#[p("salesforce.tokenurl")]' />
			<salesforce:oauth-store-config objectStore="Object_store_salesforce_oauth" />
		
</salesforce:oauth-client-credentials-connection>
	</salesforce:sfdc-config>
	<configuration-properties doc:name="Configuration properties" doc:id="a543a0be-10c9-48c5-b2de-17ca66250d33" doc:description="env-specific yaml" file="config/config-${mule.env}.yaml" />
	<secure-properties:config name="Secure_Properties_Config" doc:name="Secure Properties Config" doc:id="7388e656-2d0b-463c-abfc-f8f3aa70e3d8" file="config/secure-config-${mule.env}.yaml" key="${mule.encryptionKey}"/>
	<configuration-properties doc:name="Configuration properties" doc:id="101da9f4-2f79-4559-a244-97c76bc7fed8" doc:description="common.yaml" file="config/common.yaml" />
